# ============================================================
# DTC 广告策略引擎 v2 · 环境变量清单（只列变量名，不含真值）
# 复制本文件为 .env 后填入真值；.env 已被 .gitignore 排除
# ============================================================

# ---- LLM（§7 规则：一律用强模型，通过 base_url + api key 接入）----
# crewai 识别 OPENAI_* 作为默认 LLM；自建/中转端点走 base_url
MODEL=                       # 例：openai/gpt-5 或 gemini/gemini-2.5-pro
OPENAI_API_KEY=
OPENAI_API_BASE=             # 强模型端点（§13.3：base url + api key 方式接入）
OPENAI_MODEL_NAME=

# ---- MCP 凭证（§8）----
# 见 .codebuddy/mcp.json，占位符 ${VAR} 由本文件回填
GOOGLE_ADS_CONFIG_PATH=      # google-ads：google-ads.yaml 所在路径
META_ACCESS_TOKEN=           # meta-ads
SCRAPECREATORS_API_KEY=      # facebook-ads-library
PYTHON_PATH=                 # facebook-ads-library 依赖的 python 解释器
SIMILARWEB_API_KEY=          # similarweb（http 型 server，走 header api-key）
TAVILY_API_KEY=              # ⚠️ 待接入（§8：C1 评论发现入口的唯一阻塞项）

# ---- 运行参数 ----
DTC_MCP_CONFIG=              # 可选：覆盖 MCP 配置路径，默认 .codebuddy/mcp.json
DTC_SCRATCH_DIR=scratch
DTC_OUTPUT_DIR=output
